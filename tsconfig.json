{
	"compilerOptions": {
		// Type checking only; esbuild does the bundling (see esbuild.js).
		"noEmit": true,
		"module": "commonjs",
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"types": ["node", "vscode"],
		"rootDir": "src",
		"esModuleInterop": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"strict": true
	},
	"include": ["src"]
}
